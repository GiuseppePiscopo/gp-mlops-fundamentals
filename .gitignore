# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Datasets
###*.csv
*.tgz

# Python virtual environments
venv/
.venv/

# dotenv environment variable files
.env.*.local
.env.local

# MLflow runs data
mlruns/
mlflow.db

# Local data for Responsible AI dashboard
data/rai-train/
data/rai-test/
